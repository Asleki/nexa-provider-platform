      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./brand/nexilabs/pwa/nexilabs_icon_512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./brand/nexilabs/pwa/nexilabs_maskable_192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./brand/nexilabs/pwa/nexilabs_maskable_512x512.png",
