{
  "id": "./",
  "name": "NexiLabs PWA",
  "short_name": "NexiLabs",
  "description": "NexiLabs application shell for governed production access, simulation and evolving platform systems.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#0D1B2A",
  "theme_color": "#0D1B2A",
  "categories": [
    "education",
    "productivity",
    "utilities"
  ],
  "icons": [
