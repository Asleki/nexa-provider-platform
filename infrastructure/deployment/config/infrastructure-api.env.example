# Copy to /etc/nexa/infrastructure-api.env and chmod 600.
INFRA_ENVIRONMENT=production
INFRA_APPLICATION_NAME=Nexa Shared Infrastructure API
INFRA_APPLICATION_VERSION=0.1.0
INFRA_API_PREFIX=/api/v1
INFRA_DOCS_ENABLED=false
INFRA_TRUSTED_HOSTS=api.example.invalid
INFRA_ALLOWED_ORIGINS=https://app.example.invalid
PGHOST=npp-postgres-dev.example.rds.amazonaws.com
PGPORT=5432
PGDATABASE=npp_dev
PGUSER=npp_api_runtime
PGPASSWORD=__SET_ON_SERVER_ONLY__
PGSSLMODE=require
